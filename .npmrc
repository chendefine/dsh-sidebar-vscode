# pnpm-specific settings live in pnpm-workspace.yaml since pnpm 11:
# pnpm 11 no longer reads them from .npmrc (silently ignored there), while
# pnpm 10+ accepts both locations — keep this file for npm-compatible
# settings only (registry / auth tokens would go here).
#
# Moved keys (see pnpm-workspace.yaml):
#   auto-install-peers=false      internal @deepseek-ai/* peers are not on
#                                 the public registry
#   verify-deps-before-run=false  node_modules + lockfile are a frozen
#                                 baseline; skip the pre-run install check
